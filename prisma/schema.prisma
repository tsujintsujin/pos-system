// POS System — Prisma schema (MySQL)
// See plan: single store for v1, but location/register modeled for future multi-store.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ---------- Locations / Registers ----------

model Location {
  id        Int      @id @default(autoincrement())
  name      String
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  // Store-level settings (Phase-6 gap-list item: cash rounding rule, currency symbol,
  // receipt branding). All additive/nullable-or-defaulted — no backfill required for
  // existing rows. cashRoundingIncrement null/0 means "no rounding" (unchanged behavior).
  currencySymbol         String   @default("₱")
  cashRoundingIncrement  Decimal? @db.Decimal(4, 2)
  receiptLogoUrl         String?
  receiptFooterText      String?  @db.Text

  registers   Register[]
  users       User[]
  inventories Inventory[]
  sales       Sale[]
  shifts      Shift[]
  purchaseOrders PurchaseOrder[]

  @@map("locations")
}

model Register {
  id         Int      @id @default(autoincrement())
  locationId Int
  name       String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  location Location @relation(fields: [locationId], references: [id])
  sales    Sale[]
  shifts   Shift[]

  @@map("registers")
}

// ---------- Users / Roles ----------

enum RoleName {
  ADMIN
  MANAGER
  CASHIER
}

model Role {
  id    Int      @id @default(autoincrement())
  name  RoleName @unique
  // Two-tier permission flags (POS-terminal actions vs back-office actions)
  canAccessBackOffice   Boolean @default(false)
  canOverridePrice      Boolean @default(false)
  canApproveRefund      Boolean @default(false)
  canVoidAfterCompletion Boolean @default(false)
  canManageUsers        Boolean @default(false)
  canManageSettings     Boolean @default(false)

  users User[]

  @@map("roles")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String?  @unique
  passwordHash String?
  pinHash      String?
  roleId       Int
  locationId   Int?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  role     Role      @relation(fields: [roleId], references: [id])
  location Location? @relation(fields: [locationId], references: [id])

  salesAsCashier Sale[]      @relation("SaleCashier")
  shifts         Shift[]
  cashMovements  CashMovement[]
  stockMovements StockMovement[]
  auditLogs      AuditLog[]
  timeClockEntries TimeClockEntry[]
  returnsProcessed Return[]

  @@map("users")
}

model TimeClockEntry {
  id        Int       @id @default(autoincrement())
  userId    Int
  clockIn   DateTime  @default(now())
  clockOut  DateTime?

  user User @relation(fields: [userId], references: [id])

  @@map("time_clock_entries")
}

// ---------- Catalog ----------

model Category {
  id       Int        @id @default(autoincrement())
  name     String
  parentId Int?
  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToCategory")

  products Product[]

  @@map("categories")
}

model TaxClass {
  id            Int     @id @default(autoincrement())
  name          String
  ratePercentage Decimal @db.Decimal(6, 3)
  isInclusive   Boolean @default(false)

  products Product[]
  sales    Sale[]

  @@map("tax_classes")
}

model Product {
  id           Int      @id @default(autoincrement())
  sku          String   @unique
  barcode      String?  @unique
  name         String
  description  String?
  categoryId   Int?
  taxClassId   Int?
  costPrice    Decimal  @db.Decimal(10, 2) @default(0)
  sellPrice    Decimal  @db.Decimal(10, 2)
  imageUrl     String?
  isActive     Boolean  @default(true)
  trackStock   Boolean  @default(true)
  isComposite  Boolean  @default(false)
  reorderThreshold Int  @default(0)
  createdAt    DateTime @default(now())

  category Category? @relation(fields: [categoryId], references: [id])
  taxClass TaxClass? @relation(fields: [taxClassId], references: [id])

  variants        ProductVariant[]
  inventories     Inventory[]
  saleLineItems   SaleLineItem[]
  poLineItems     PurchaseOrderLineItem[]
  components      ProductComponent[] @relation("CompositeParent")
  usedInComposite ProductComponent[] @relation("ComponentProduct")

  @@map("products")
}

// A composite/bundle product is made of other products (stock deducts from components)
model ProductComponent {
  id           Int @id @default(autoincrement())
  parentId     Int
  componentId  Int
  quantity     Decimal @db.Decimal(10, 3)

  parent    Product @relation("CompositeParent", fields: [parentId], references: [id])
  component Product @relation("ComponentProduct", fields: [componentId], references: [id])

  @@map("product_components")
}

// Variant = alternate sell-unit of the same product (e.g. case of 24 vs single piece),
// or a true variant (size/color). unitsPerParent converts to the base product's stock unit.
model ProductVariant {
  id             Int     @id @default(autoincrement())
  productId      Int
  name           String  // e.g. "Case of 24", "Small", "Red"
  sku            String  @unique
  barcode        String? @unique
  priceOverride  Decimal? @db.Decimal(10, 2)
  unitsPerParent Int     @default(1) // 1 case = N base units

  product     Product      @relation(fields: [productId], references: [id])
  inventories Inventory[]
  saleLineItems SaleLineItem[]

  @@map("product_variants")
}

// ---------- Inventory ----------

model Inventory {
  id         Int @id @default(autoincrement())
  locationId Int
  productId  Int
  variantId  Int?
  quantityOnHand Decimal @db.Decimal(12, 3) @default(0)

  location Location        @relation(fields: [locationId], references: [id])
  product  Product         @relation(fields: [productId], references: [id])
  variant  ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([locationId, productId, variantId])
  @@map("inventory")
}

enum StockMovementReason {
  SALE
  RETURN
  ADJUSTMENT
  RECEIVING
  TRANSFER
  DAMAGE
  THEFT
  EXPIRY
  COUNT_CORRECTION
}

model StockMovement {
  id           Int                 @id @default(autoincrement())
  locationId   Int
  productId    Int
  variantId    Int?
  quantityDelta Decimal            @db.Decimal(12, 3)
  reason       StockMovementReason
  referenceId  Int? // sale id / PO id / return id, depending on reason
  createdById  Int?
  createdAt    DateTime            @default(now())

  createdBy User? @relation(fields: [createdById], references: [id])

  @@map("stock_movements")
}

// ---------- Suppliers / Purchase Orders ----------

model Supplier {
  id          Int    @id @default(autoincrement())
  name        String
  contactInfo String?
  paymentTerms String?

  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIAL
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id           Int                 @id @default(autoincrement())
  supplierId   Int
  locationId   Int
  status       PurchaseOrderStatus @default(DRAFT)
  expectedDate DateTime?
  createdAt    DateTime            @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id])
  location Location @relation(fields: [locationId], references: [id])
  lineItems PurchaseOrderLineItem[]

  @@map("purchase_orders")
}

model PurchaseOrderLineItem {
  id               Int     @id @default(autoincrement())
  purchaseOrderId  Int
  productId        Int
  quantityOrdered  Decimal @db.Decimal(12, 3)
  quantityReceived Decimal @db.Decimal(12, 3) @default(0)
  unitCost         Decimal @db.Decimal(10, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  product       Product       @relation(fields: [productId], references: [id])

  @@map("purchase_order_line_items")
}

// ---------- Customers ----------

model CustomerGroup {
  id                 Int     @id @default(autoincrement())
  name               String
  discountPercentage Decimal @db.Decimal(5, 2) @default(0)

  customers Customer[]

  @@map("customer_groups")
}

model Customer {
  id                  Int     @id @default(autoincrement())
  name                String
  phone               String? @unique
  email               String?
  loyaltyPointsBalance Int    @default(0)
  storeCreditBalance   Decimal @db.Decimal(10, 2) @default(0)
  customerGroupId     Int?
  createdAt           DateTime @default(now())

  customerGroup CustomerGroup? @relation(fields: [customerGroupId], references: [id])
  sales         Sale[]

  @@map("customers")
}

// ---------- Sales ----------

enum SaleStatus {
  PARKED
  COMPLETED
  VOIDED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Sale {
  id             Int        @id @default(autoincrement())
  receiptNumber  String     @unique
  locationId     Int
  registerId     Int
  cashierId      Int
  customerId     Int?
  shiftId        Int?
  taxClassId     Int?
  subtotal       Decimal    @db.Decimal(12, 2) @default(0)
  discountTotal  Decimal    @db.Decimal(12, 2) @default(0)
  taxTotal       Decimal    @db.Decimal(12, 2) @default(0)
  grandTotal     Decimal    @db.Decimal(12, 2) @default(0)
  status         SaleStatus @default(PARKED)
  createdAt      DateTime   @default(now())
  completedAt    DateTime?

  location Location  @relation(fields: [locationId], references: [id])
  register Register  @relation(fields: [registerId], references: [id])
  cashier  User      @relation("SaleCashier", fields: [cashierId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  shift    Shift?    @relation(fields: [shiftId], references: [id])
  taxClass TaxClass? @relation(fields: [taxClassId], references: [id])

  lineItems SaleLineItem[]
  payments  Payment[]
  returns   Return[]

  @@map("sales")
}

model SaleLineItem {
  id             Int     @id @default(autoincrement())
  saleId         Int
  productId      Int
  variantId      Int?
  quantity       Decimal @db.Decimal(12, 3)
  unitPrice      Decimal @db.Decimal(10, 2)
  discountAmount Decimal @db.Decimal(10, 2) @default(0)
  taxAmount      Decimal @db.Decimal(10, 2) @default(0)
  lineTotal      Decimal @db.Decimal(12, 2)

  sale    Sale            @relation(fields: [saleId], references: [id])
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  returnLineItems ReturnLineItem[]

  @@map("sale_line_items")
}

// ---------- Payments (skeleton — no live gateway yet) ----------

model PaymentMethod {
  id       Int     @id @default(autoincrement())
  name     String  @unique // Cash, GCash, Card
  isActive Boolean @default(true)

  payments Payment[]

  @@map("payment_methods")
}

model Payment {
  id              Int     @id @default(autoincrement())
  saleId          Int
  paymentMethodId Int
  amount          Decimal @db.Decimal(12, 2)
  tenderedAmount  Decimal? @db.Decimal(12, 2)
  changeGiven     Decimal? @db.Decimal(12, 2)
  referenceNumber String? // future gateway auth code / GCash ref
  createdAt       DateTime @default(now())

  sale          Sale          @relation(fields: [saleId], references: [id])
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  @@map("payments")
}

// ---------- Discounts ----------

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum DiscountAppliesTo {
  PRODUCT
  CATEGORY
  CART
}

model Discount {
  id          Int               @id @default(autoincrement())
  name        String
  type        DiscountType
  value       Decimal           @db.Decimal(10, 2)
  appliesTo   DiscountAppliesTo
  startDate   DateTime?
  endDate     DateTime?
  active      Boolean           @default(true)

  @@map("discounts")
}

// ---------- Returns / Refunds ----------

enum RefundMethod {
  ORIGINAL_PAYMENT
  CASH
  STORE_CREDIT
}

model Return {
  id             Int          @id @default(autoincrement())
  originalSaleId Int
  processedById  Int
  reason         String?
  refundMethod   RefundMethod
  totalRefunded  Decimal      @db.Decimal(12, 2)
  createdAt      DateTime     @default(now())

  originalSale Sale @relation(fields: [originalSaleId], references: [id])
  processedBy  User @relation(fields: [processedById], references: [id])

  lineItems ReturnLineItem[]

  @@map("returns")
}

model ReturnLineItem {
  id             Int     @id @default(autoincrement())
  returnId       Int
  saleLineItemId Int
  quantityReturned Decimal @db.Decimal(12, 3)
  restocked      Boolean @default(false)

  return       Return       @relation(fields: [returnId], references: [id])
  saleLineItem SaleLineItem @relation(fields: [saleLineItemId], references: [id])

  @@map("return_line_items")
}

// ---------- Shifts / Cash Drawer ----------

model Shift {
  id            Int       @id @default(autoincrement())
  registerId    Int
  locationId    Int
  cashierId     Int
  openingFloat  Decimal   @db.Decimal(10, 2)
  closingCount  Decimal?  @db.Decimal(10, 2)
  expectedCash  Decimal?  @db.Decimal(10, 2)
  variance      Decimal?  @db.Decimal(10, 2)
  openedAt      DateTime  @default(now())
  closedAt      DateTime?

  register Register @relation(fields: [registerId], references: [id])
  location Location @relation(fields: [locationId], references: [id])
  cashier  User     @relation(fields: [cashierId], references: [id])

  sales         Sale[]
  cashMovements CashMovement[]

  @@map("shifts")
}

enum CashMovementType {
  PAID_IN
  PAID_OUT
  SAFE_DROP
}

model CashMovement {
  id        Int              @id @default(autoincrement())
  shiftId   Int
  type      CashMovementType
  amount    Decimal          @db.Decimal(10, 2)
  reason    String?
  createdById Int
  createdAt DateTime         @default(now())

  shift     Shift @relation(fields: [shiftId], references: [id])
  createdBy User  @relation(fields: [createdById], references: [id])

  @@map("cash_movements")
}

// ---------- Audit ----------

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  action     String
  entityType String
  entityId   Int?
  beforeValue Json?
  afterValue  Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}
