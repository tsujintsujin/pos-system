# pos-system — required environment variables.
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Pooled Postgres connection string used by the running app.
# Supabase dashboard -> Project Settings -> Database -> Connection string ->
# "Transaction pooler" (port 6543). Consumed by lib/prisma.ts via the
# @prisma/adapter-pg adapter.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Direct (non-pooled) Postgres connection string, used ONLY by the Prisma CLI
# for `prisma migrate` / introspection — pgbouncer's transaction-mode pooler
# can't handle the prepared statements and DDL migrations need. Same Supabase
# page, "Direct connection" (port 5432). Read in prisma.config.ts.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Signing secret for the session JWT. Any long random string — generate one
# locally, e.g. `openssl rand -base64 48`. Verified in proxy.ts and lib/auth.ts;
# changing it invalidates every existing session cookie.
JWT_SECRET="replace-with-a-long-random-string"
